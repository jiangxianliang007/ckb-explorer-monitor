# Required
API_URL=https://mainnet-api.explorer.nervos.org
NET=mainnet
# URL of the upstream CKB JSON-RPC node that this Explorer instance uses.
# The exporter must be deployed in a network where it can reach this node.
NODE_RPC_URL=http://ckb-node:8114

# Optional (defaults shown)
EXPORTER_PORT=9333
SCRAPE_INTERVAL=30
HTTP_TIMEOUT=10
